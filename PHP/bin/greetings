#!/usr/bin/env php
<?php

// Composition root: the only file that knows both the domain and the adapters.
// Usage: bin/greetings [--dry-run]

use BirthdayGreetings\Domain\BirthdayService;
use BirthdayGreetings\Domain\XDate;
use BirthdayGreetings\Infrastructure\ConsoleGreetingsSender;
use BirthdayGreetings\Infrastructure\FileEmployeeRepository;
use BirthdayGreetings\Infrastructure\SmtpGreetingsSender;

require __DIR__ . '/../vendor/autoload.php';

$sender = in_array('--dry-run', $argv, true)
    ? new ConsoleGreetingsSender()
    : new SmtpGreetingsSender('maildev', 1025, 'sender@here.com');

$service = new BirthdayService(
    new FileEmployeeRepository(__DIR__ . '/../employee_data.txt'),
    $sender,
);
$service->sendGreetings(new XDate());
